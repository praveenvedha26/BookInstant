# ==============================================================================
# BOOKINSTANT - COMPREHENSIVE .GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Backend Build Artifacts
# ------------------------------------------------------------------------------
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.hprof
*.ctxt

# Crash logs & profilers
hs_err_pid*
replay_pid*

# Maven & Gradle
backend/target/
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.gradle/
build/

# Mobile Tools for Java
.mtj.tmp/

# ------------------------------------------------------------------------------
# 2. Node, Frontend & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
dist/
*/dist/
frontend/dist/
.vite/
*/.vite/
frontend/.vite/
coverage/
.nyc_output/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
